# Copy this file to .env (git-ignored) and fill in the values. docker compose reads .env
# automatically and refuses to start while POSTGRES_PASSWORD is unset.

# ---- Database ----
# REQUIRED. Choose your own strong password, e.g. generate one with: openssl rand -hex 24
# Keep it free of URL-special characters (@ : / ? #) because compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=sportsdata

# SportsService reads DATABASE_URL (there is NO built-in default). docker-compose.yml builds it
# from POSTGRES_PASSWORD, so you only set it by hand when running the service outside Docker:
# DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/sportsdata

# Service Ports
PING_SERVICE_PORT=5000
SPORTS_SERVICE_PORT=5001
DATABASE_PORT=5432

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
PYTHONUNBUFFERED=1

# Optional: Rate limiting for API calls
API_RATE_LIMIT=100

# Optional: Data retention (days)
DATA_RETENTION_DAYS=30
